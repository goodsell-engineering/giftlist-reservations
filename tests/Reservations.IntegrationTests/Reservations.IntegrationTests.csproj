<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- CONVENTIONS.md "Testing": all infrastructure real via Testcontainers, Mongo and RabbitMQ
         both — never an in-memory substitute for either. GL-36 adds the first real messaging
         code this suite exercises: the ReserveGift request/reply handler (reached through the
         real bridge) and the GiftLists projection's four Rebus handlers (GL-34), so RabbitMQ
         joins Mongo here. Only one Testcontainers slot exists on the build machine — run this
         suite sequentially with every other repo's IntegrationTests, never concurrently. -->
    <PackageReference Include="Testcontainers.MongoDb" Version="4.14.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reservations.Host\Reservations.Host.csproj" />
    <!-- GL-93: ReliableReadiness's WithReliableWaitStrategy/StartReliablyAsync, required of every
         Testcontainers builder this suite starts (SuiteLabelRuleTests). -->
    <PackageReference Include="BuildingBlocks.Testing" Version="[0.1.0]" />
  </ItemGroup>
</Project>

