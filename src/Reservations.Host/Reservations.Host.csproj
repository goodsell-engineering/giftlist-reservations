<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UserSecretsId>dotnet-Reservations.Host-c7ae27b8-29fa-45e0-9281-d2385fd03787</UserSecretsId>
  </PropertyGroup>

  <!-- GL-52: an ops-only Kestrel listener (/healthz) on an otherwise non-HTTP worker host, per
       ARCHITECTURE.md "Why workers still need a little HTTP". Not a business API. The Microsoft.Extensions.Hosting
       PackageReference that used to sit here is gone on purpose: this FrameworkReference brings
       it in transitively (NU1510 fails the build on the redundant explicit reference), and
       WebApplication.CreateBuilder in Program.cs already builds on the generic host. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reservations.Infrastructure\Reservations.Infrastructure.csproj" />
    <!-- GL-52: composition root wires the shared Mongo/Rebus/health-check helpers directly.
         CONVENTIONS.md "Project reference graph" permits BuildingBlocks.Infrastructure to be referenced by Host as
         well as Infrastructure. GL-43: bumped to 0.2.0 for the explicit Rebus retry/error-queue
         policy (RebusConfigurationExtensions — MaxDeliveryAttempts, ErrorQueueName), then to
         0.2.1 (0.2.0's poison classification checked the wrong exception type and never actually
         fired). GL-45: bumped to 0.3.0 — CorrelationIdIncomingStep now also logs, and this Host
         calls the new AddBuildingBlocksLogging so that log actually renders. No further per-host
         change needed for the retry policy: the error queue name is derived automatically
         from the "reservation" input queue name this host already passes to
         AddBuildingBlocksRebus. -->
    <PackageReference Include="BuildingBlocks.Infrastructure" Version="[0.3.0]" />
  </ItemGroup>
</Project>
